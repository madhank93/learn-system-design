# DISTRIBUTED CHALLENGES (Gossip Glomers — fly.io/dist-sys)
# Prerequisites: Java 11+, Maelstrom binary at ./maelstrom/maelstrom (download into hld dir)
# Download: https://github.com/jepsen-io/maelstrom/releases
# ══════════════════════════════════════════════════════════════

# Build all challenge binaries
dc-build-all:
    #!/usr/bin/env bash
    set -euo pipefail
    # Run from high-level-design/ — distributed-challenges/ is a subdirectory
    challenges=(
        distributed-challenges/c1_echo
        distributed-challenges/c2_unique_ids
        distributed-challenges/c3a_broadcast_single
        distributed-challenges/c3b_broadcast_multi
        distributed-challenges/c3c_broadcast_fault_tolerant
        distributed-challenges/c3d_broadcast_efficient
        distributed-challenges/c4_grow_only_counter
        distributed-challenges/c5a_kafka_single
        distributed-challenges/c5b_kafka_multi
        distributed-challenges/c5c_kafka_efficient
        distributed-challenges/c6a_txn_read_uncommitted
        distributed-challenges/c6b_txn_read_committed
    )
    for c in "${challenges[@]}"; do
        echo "building $c..."
        (cd "$c" && go build -o "$(basename $c)" .)
    done
    echo "All challenge binaries built"

# ── Individual builds ─────────────────────────────────────────

dc-c1:
    cd distributed-challenges/c1_echo && go build -o c1_echo .
    @echo "Run: ./maelstrom/maelstrom test -w echo --bin high-level-design/distributed-challenges/c1_echo/c1_echo --node-count 1 --time-limit 10"

dc-c2:
    cd distributed-challenges/c2_unique_ids && go build -o c2_unique_ids .
    @echo "Run: ./maelstrom/maelstrom test -w unique-ids --bin high-level-design/distributed-challenges/c2_unique_ids/c2_unique_ids --node-count 3 --availability total --nemesis partition --time-limit 30 --rate 1000"

