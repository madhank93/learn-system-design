# BULK OPERATIONS
# ══════════════════════════════════════════════════════════════

# Run all HLD integration tests sequentially (up → test → down per topic)
test-all:
    #!/usr/bin/env bash
    set -euo pipefail
    dirs=(
        networking-and-edge/2.1_load_balancer
        networking-and-edge/2.2_cdn
        networking-and-edge/2.3_dns
        networking-and-edge/2.4_api_gateway
        networking-and-edge/2.5_websockets_sse
        scalability/3.1_caching
        scalability/3.2_rate_limiting
        scalability/3.3_db_sharding
        scalability/3.4_db_replication
        data-and-consistency/4.1_cap_theorem
        data-and-consistency/4.2_sql_vs_nosql
        data-and-consistency/4.3_consistent_hashing
        data-and-consistency/4.4_cqrs_event_sourcing
        data-and-consistency/4.5_leader_election
        resilience/5.1_circuit_breaker
        resilience/5.2_retry_backoff
        resilience/5.3_distributed_locking
        async-and-communication/6.1_message_queues
        async-and-communication/6.2_service_discovery
        async-and-communication/6.3_distributed_tracing
        algorithms/7.1_bloom_filter
        algorithms/7.2_geohashing
        algorithms/7.3_indexing
        security/8.1_oauth_jwt
    )
    pass=0; fail=0
    for d in "${dirs[@]}"; do
        echo ""
        echo "== $d =="
        docker compose -f "$d/docker-compose.yml" up --build -d --quiet-pull 2>/dev/null
        sleep 3
        if bash "$d/test.sh"; then
            echo "PASS  $d"
            ((pass++)) || true
        else
            echo "FAIL  $d"
            ((fail++)) || true
        fi
        docker compose -f "$d/docker-compose.yml" down --volumes --remove-orphans 2>/dev/null || true
    done
    echo ""
    echo "Results: $pass passed, $fail failed"

# Stop and remove all running containers
down-all:
    #!/usr/bin/env bash
    set -euo pipefail
    find . -name "docker-compose.yml" | while read f; do
        dir=$(dirname "$f")
        docker compose -f "$f" down --volumes --remove-orphans 2>/dev/null || true
        echo "stopped $dir"
    done
    echo "All containers stopped"
