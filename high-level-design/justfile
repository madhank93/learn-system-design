# ─────────────────────────────────────────────────────────────
#  HLD Justfile — system design learning path
#  Usage: just <recipe>   e.g.  just list   just caching-up
# ─────────────────────────────────────────────────────────────

list:
    @just --list

# ── Shared helpers ────────────────────────────────────────────

docker-clean:
    #!/usr/bin/env bash
    set -euo pipefail
    docker system prune -af --volumes
    docker builder prune -af

compose-up dir:
    @echo "Starting {{dir}}..."
    cd {{dir}} && docker compose up --force-recreate --build -d

compose-down dir:
    @echo "Stopping {{dir}}..."
    cd {{dir}} && docker compose down --rmi all --volumes --remove-orphans 2>/dev/null || true

run-test dir:
    @echo "Testing {{dir}}..."
    @bash {{dir}}/test.sh

lab-check dir step:
    @bash {{dir}}/lab/check.sh {{step}}

# Smoke-run every topic lab happy-path end-to-end (Docker required).
# WARNING: tears down and rebuilds each topic's compose stack — don't run mid-lab.
lab-verify-all:
    @bash networking-and-edge/2.1_load_balancer/lab/verify.sh
    @just syslings-verify load-balancing
    @just syslings-verify caching

# syslings — rustlings-style interactive exercises (fix broken configs against
# the live stack, watch mode, hints). Runs the TUI for a topic.
syslings *topic:
    cd ../syslings && go run . {{topic}}

# CI: prove every syslings exercise is solvable (seeds solutions, runs checks).
# WARNING: rebuilds the topic's compose stack — don't run mid-session.
syslings-verify topic="load-balancing":
    cd ../syslings && go run . verify {{topic}}

# ── Go unit tests (no Docker needed) ─────────────────────────

unit-test:
    #!/usr/bin/env bash
    set -euo pipefail
    cd ..
    go test -v -count=1 \
        networking-fundamentals \
        scaling-fundamentals \
        latency-throughput \
        availability-slas \
        acid-vs-base \
        db-shard shard-router \
        ch-router \
        cb-proxy \
        db-primary db-replica \
        bloom-server \
        retry-client \
        dist-lock-worker \
        leader-election-node \
        geohash-server \
        indexing-server \
        auth-server \
        url-shortener \
        twitter-feed \
        ride-sharing \
        realtime-chat \
        video-streaming
    echo "All unit tests passed"

# Integration tests — spins up real Docker containers via Testcontainers
# Requires Docker daemon running. Each test manages its own container lifecycle.
integration-test:
    #!/usr/bin/env bash
    set -euo pipefail
    cd ..
    go test -v -count=1 -tags integration -timeout 300s \
        dist-lock-worker \
        cqrs-writer \
        cqrs-reader \
        mq-producer \
        mq-consumer \
        sd-service \
        sd-client
    echo "All integration tests passed"

