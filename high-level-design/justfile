# ── Bulk operations ───────────────────────────────────────────

# Run all integration tests sequentially (up → test → down per topic)
test-all:
    #!/usr/bin/env bash
    set -euo pipefail
    dirs=(
        02_load_balancer 03_rate_limiting 04_caching
        05_message_queues 06_db_sharding 07_api_gateway
        08_consistent_hashing 09_cdn 10_circuit_breaker
        11_service_discovery 12_cqrs_event_sourcing 13_dns
        14_db_replication 15_cap_theorem 16_sql_vs_nosql
        17_bloom_filter 18_websockets_sse 19_distributed_locking
        20_retry_backoff
    )
    pass=0; fail=0
    for d in "${dirs[@]}"; do
        echo ""
        echo "== $d =="
        docker compose -f "$d/docker-compose.yml" up --build -d --quiet-pull 2>/dev/null
        sleep 3
        if bash "$d/test.sh"; then
            echo "PASS  $d"
            ((pass++)) || true
        else
            echo "FAIL  $d"
            ((fail++)) || true
        fi
        docker compose -f "$d/docker-compose.yml" down --volumes --remove-orphans 2>/dev/null || true
    done
    echo ""
    echo "Results: $pass passed, $fail failed"

# Stop and remove all running HLD containers
down-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for dir in */; do
        [ -f "$dir/docker-compose.yml" ] || continue
        docker compose -f "$dir/docker-compose.yml" down --volumes --remove-orphans 2>/dev/null || true
        echo "stopped $dir"
    done
    echo "All HLD containers stopped"
