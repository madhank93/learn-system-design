# Scaling Fundamentals — Vertical vs Horizontal Scaling
# d2 --sketch --layout elk overview.d2 ../../svg/1.3_scaling_fundamentals/overview.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

vertical: Vertical Scaling (Scale Up) {
  style.fill: "#F1EEE8"
  style.stroke: "#E67E22"

  small: Small\n2 CPU · 8 GB {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }

  medium: Medium\n16 CPU · 64 GB {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }

  large: Large\n64 CPU · 256 GB {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }

  ceiling: Ceiling ⚠ {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  small -> medium: upgrade
  medium -> large: upgrade
  large -> ceiling: blocked
}

horizontal: Horizontal Scaling (Scale Out) {
  style.fill: "#F1EEE8"
  style.stroke: "#27AE60"

  lb: Load Balancer {
    shape: hexagon
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  s1: Server 1 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  s2: Server 2 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  lb -> s1
  lb -> s2
}

client: Client {
  shape: person
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
}

client -> vertical.small
client -> horizontal.lb

scenarios: {
  horizontal_growth: {
    horizontal: Horizontal — 4 servers {
      style.stroke-width: 3
    }

    horizontal.s3: Server 3 {
      style.fill: "#3498DB"
      style.stroke: "#2471A3"
      style.font-color: "#FFFFFF"
    }

    horizontal.s4: Server 4 {
      style.fill: "#3498DB"
      style.stroke: "#2471A3"
      style.font-color: "#FFFFFF"
    }

    horizontal.lb -> horizontal.s3 {
      style.stroke: "#3498DB"
      style.animated: true
    }
    horizontal.lb -> horizontal.s4 {
      style.stroke: "#3498DB"
      style.animated: true
    }
  }
}
