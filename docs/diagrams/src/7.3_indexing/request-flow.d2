# Indexing — Query With vs Without Index
# d2 --sketch --layout elk request-flow.d2 ../../svg/7.3_indexing/request-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

query: SELECT * FROM orders\nWHERE user_id=42\nORDER BY created_at DESC\nLIMIT 10 {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

planner: Query Planner {
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

with_index: With Index\nidx_orders_user_created(user_id, created_at) {
  style.fill: "#F1EEE8"
  style.stroke: "#27AE60"

  step1: B-Tree traverse\n(root → leaf) — 3 I/O ops {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  step2: Leaf → 47 row pointers\nfor user_id=42 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  step3: Already sorted by\ncreated_at (index covers ORDER BY) {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  result: LIMIT 10 → return\nTotal: 4ms ✓ {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  step1 -> step2 -> step3 -> result
}

without_index: Without Index {
  style.fill: "#F1EEE8"
  style.stroke: "#E74C3C"

  seq_scan: Sequential scan\n10M rows read {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  filter: Filter: user_id=42\n→ 47 rows match {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  sort: Sort 47 rows by\ncreated_at — extra pass {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  result_bad: LIMIT 10 → return\nTotal: 8200ms ✗ {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  seq_scan -> filter -> sort -> result_bad
}

query -> planner
planner -> with_index: index exists → use it {
  style.stroke: "#27AE60"
  style.stroke-width: 2
}
planner -> without_index: no index → seqscan {
  style.stroke-dash: 5
  style.stroke: "#E74C3C"
}

scenarios: {
  index_bloat: {
    with_index.step1: B-Tree traverse\n⚠ fragmented pages {
      style.fill: "#D35400"
      style.stroke: "#A04000"
      style.font-color: "#FFFFFF"
    }
  }
}
