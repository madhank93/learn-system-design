# Networking fundamentals — TCP/IP stack
# One idea: each layer wraps the one above; the server mirrors this stack in reverse.
# Scenarios: tcp_handshake (transport highlighted), dns_cache_hit.

vars: { d2-config: { layout-engine: elk } }
direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

stack: "TCP/IP stack" {
  style.fill: "#F1EEE8"
  style.stroke: "#D5D0C8"

  app: "Application\nHTTP · DNS · TLS" {
    style.fill: "#3498DB"
    style.stroke: "#2471A3"
    style.font-color: "#FFFFFF"
  }

  transport: "Transport\nTCP / UDP" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  net: "Network\nIP" {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }

  phys: "Link\nEthernet · WiFi" {
    style.fill: "#5D6D7E"
    style.stroke: "#424949"
    style.font-color: "#FFFFFF"
  }

  app -> transport: "1. stream"
  transport -> net: "2. segments"
  net -> phys: "3. packets"
}

dns: "DNS resolver" {
  shape: cloud
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

internet: Internet {
  shape: cloud
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

stack.app -> dns: "lookup" {
  style.stroke-dash: 5
  style.stroke: "#3498DB"
}
stack.phys -> internet: "4. frames"

scenarios: {
  tcp_handshake: {
    stack.transport: "Transport\nSYN → SYN-ACK → ACK" {
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
      style.stroke-width: 4
    }
  }

  dns_cache_hit: {
    dns: "DNS resolver\n✓ cache HIT" {
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
    }
    (stack.app -> dns)[0]: "0 ms lookup" {
      style.stroke: "#27AE60"
      style.stroke-width: 3
    }
  }
}
