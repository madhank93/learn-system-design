# OAuth 2.0 and JWT — JWT Token Structure
# d2 --sketch --layout elk jwt-structure.d2 ../../svg/8.1_oauth_jwt/jwt-structure.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

jwt_structure: JWT Structure (header.payload.signature) {
  direction: down
  style.fill: "#F1EEE8"
  style.stroke: "#D35400"

  header: "Header\nalg:RS256, kid:k1" {
    style.fill: "#3498DB"
    style.stroke: "#2471A3"
    style.font-color: "#FFFFFF"
  }

  payload: "Payload\nsub:user:42, scope:read, exp" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  sig: "Signature\nRSASHA256(header.payload, privKey)" {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }

  header -> payload: "."
  payload -> sig: "."
}
