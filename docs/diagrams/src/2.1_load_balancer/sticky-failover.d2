# Load balancer — sticky session failover
# One idea: pinned server dies → LB rewrites the cookie; session state is lost.

vars: { d2-config: { layout-engine: elk } }
direction: right

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

client: Client {
  shape: person
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
}

lb: "Load balancer" {
  shape: hexagon
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
  style.bold: true
}

s1: "Server 1" {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

s2: "Server 2 ✖ down" {
  style.fill: "#E74C3C"
  style.stroke: "#C0392B"
  style.font-color: "#FFFFFF"
}

client -> lb: "1. cookie srv=s2"
lb -> s2: "2. pinned ✖" {
  style.stroke: "#E74C3C"
  style.stroke-dash: 7
  style.opacity: 0.4
}
lb -> s1: "3. failover" {
  style.stroke: "#D35400"
  style.stroke-width: 3
  style.animated: true
}
lb -> client: "4. new cookie" {
  style.stroke: "#D35400"
}
