# Load balancer — request lifecycle (animated steps)
# Fixed topology; each step changes exactly one thing.
# Frames: ① request in → ② skip down server → ③ route to S1 → ④ S1 responds → ⑤ reply to client

vars: { d2-config: { layout-engine: elk } }
direction: right

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

client: Client {
  shape: person
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
}

lb: "Load balancer" {
  shape: hexagon
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
  style.bold: true
}

pool: "Backend pool" {
  style.fill: "#F1EEE8"
  style.stroke: "#D5D0C8"

  s1: "Server 1" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  s2: "Server 2" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }

  s3: "Server 3 ✖ down" {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
}

note: "request lifecycle — 5 steps" {
  shape: text
  near: top-center
  style.font-size: 18
  style.bold: true
}

steps: {
  1: {
    note: "① GET /orders hits the LB"
    client -> lb: "1. GET" {
      style.stroke: "#3498DB"
      style.animated: true
    }
  }
  2: {
    note: "② routing table — Server 3 excluded"
    lb -> pool.s3: "2. skip ✖" {
      style.stroke: "#E74C3C"
      style.stroke-dash: 7
      style.opacity: 0.4
    }
  }
  3: {
    note: "③ round-robin picks Server 1"
    lb -> pool.s1: "3. route" {
      style.stroke: "#27AE60"
      style.stroke-width: 3
      style.animated: true
    }
  }
  4: {
    note: "④ Server 1 returns 200 OK"
    pool.s1 -> lb: "4. 200 OK" {
      style.stroke: "#27AE60"
    }
  }
  5: {
    note: "⑤ LB relays response to client"
    lb -> client: "5. 200 OK" {
      style.stroke: "#27AE60"
      style.stroke-width: 3
      style.animated: true
    }
  }
}
