# Retry and backoff — strategy comparison
# One idea: when to retry matters more than whether to retry.
# Scenarios: thundering_herd (immediate ✗), jitter_spread (expo + jitter ✓).

vars: { d2-config: { layout-engine: elk } }
direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

immediate: "Immediate retry ✗" {
  style.fill: "#F1EEE8"
  style.stroke: "#E74C3C"

  a1: "0 ms" {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
  a2: "0 ms" {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
  a3: "0 ms" {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
  a1 -> a2 -> a3
}

fixed: "Fixed backoff ≈" {
  style.fill: "#F1EEE8"
  style.stroke: "#D35400"

  b1: "0 ms" {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }
  b2: "wait 1 s" {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }
  b3: "wait 1 s" {
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }
  b1 -> b2 -> b3
}

expo: "Exponential + jitter ✓" {
  style.fill: "#F1EEE8"
  style.stroke: "#27AE60"

  c1: "0 ms" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  c2: "~1.3 s" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  c3: "~2.7 s" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  c4: "~5.4 s" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  c1 -> c2 -> c3 -> c4
}

scenarios: {
  thundering_herd: {
    immediate: "Immediate ✗ — 1000-client burst" {
      style.stroke-width: 4
      style.stroke: "#C0392B"
    }
  }

  jitter_spread: {
    expo: "Expo + jitter ✓ — spread over 10 s" {
      style.stroke-width: 4
      style.stroke: "#1E8449"
    }
  }
}
