# Service Discovery — Service-to-Service Call
# d2 --sketch --layout elk request-flow.d2 ../../svg/6.2_service_discovery/request-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

order_svc: Order Service {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

consul: Consul\n(service registry) {
  shape: cylinder
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

cache: Local Cache\n(TTL=30s) {
  shape: cylinder
  style.fill: "#D35400"
  style.stroke: "#A04000"
  style.font-color: "#FFFFFF"
}

payment_1: Payment Service\n(10.0.2.1:8080) {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

payment_2: Payment Service\n(10.0.2.2:8080) {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

order_svc -> cache: check cache for payment-svc
cache -> consul: MISS — query registry {
  style.stroke-dash: 5
}
consul -> cache: "[10.0.2.1:8080, 10.0.2.2:8080]"
cache -> order_svc: healthy instances
order_svc -> payment_1: round-robin → 10.0.2.1
payment_1 -> order_svc: 200 OK

scenarios: {
  stale_cache: {
    payment_1: Payment Service\n(10.0.2.1)\n⚠ DOWN {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
    cache: Local Cache\n(stale entry) {
      style.fill: "#D35400"
      style.stroke: "#A04000"
      style.font-color: "#FFFFFF"
    }
    order_svc -> payment_2: retry → 10.0.2.2 {
      style.stroke: "#27AE60"
      style.stroke-width: 3
      style.animated: true
    }
    payment_2 -> order_svc: 200 OK
  }
}
