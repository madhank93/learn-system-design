# Message Queues — Order Processing with Kafka
# d2 --sketch --layout elk request-flow.d2 ../../svg/6.1_message_queues/request-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

api: API Server {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

kafka: Kafka\n(topic: orders, partition=user_id%3) {
  shape: queue
  style.fill: "#D35400"
  style.stroke: "#A04000"
  style.font-color: "#FFFFFF"
}

order_svc: Order Service\n(consumer group A) {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

notif_svc: Notification Service\n(consumer group B) {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

audit_svc: Audit Service\n(consumer group C) {
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

order_db: Order DB {
  shape: cylinder
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

api -> kafka: "PRODUCE OrderCreated (id:789, user:42) → offset=47"
kafka -> order_svc: CONSUME offset=47 {
  style.animated: true
  style.stroke: "#27AE60"
}
kafka -> notif_svc: CONSUME offset=47 {
  style.animated: true
  style.stroke: "#27AE60"
  style.stroke-dash: 5
}
kafka -> audit_svc: CONSUME offset=47 {
  style.stroke-dash: 5
  style.animated: true
}
order_svc -> order_db: INSERT order
order_svc -> kafka: COMMIT offset=47

scenarios: {
  consumer_failure: {
    order_svc: Order Service\n⚠ CRASHED at offset=48 {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
    kafka: Kafka\n(retains offset 48+) {
      style.fill: "#D35400"
      style.stroke: "#A04000"
      style.font-color: "#FFFFFF"
    }
  }
}
