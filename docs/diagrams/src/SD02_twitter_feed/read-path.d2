# Twitter feed — read path
# One idea: feed reads are cheap because fanout already did the work.
# Scenario hot_celebrity: feed service merges celebrity tweets at read time.

vars: { d2-config: { layout-engine: elk } }
direction: right

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

follower: Follower {
  shape: person
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
}

feed_svc: "Feed service" {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
  style.bold: true
}

timelines: "Timeline cache" {
  shape: cylinder
  style.fill: "#D35400"
  style.stroke: "#A04000"
  style.font-color: "#FFFFFF"
}

store: "Tweet store" {
  shape: cylinder
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

follower -> feed_svc: "1. GET /feed"
feed_svc -> timelines: "2. top 100 IDs"
feed_svc -> store: "3. hydrate tweets"
feed_svc -> follower: "4. ranked feed" {
  style.stroke: "#27AE60"
  style.stroke-width: 3
}

scenarios: {
  hot_celebrity: {
    feed_svc: "Feed service\nhybrid merge" {
      style.stroke-width: 3
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
    }
    (feed_svc -> store)[0]: "3. + celeb tweets" {
      style.stroke: "#D35400"
      style.stroke-width: 3
      style.animated: true
    }
  }
}
