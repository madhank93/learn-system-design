# Distributed Tracing — Trace Propagation
# d2 --sketch --layout elk request-flow.d2 ../../svg/6.3_distributed_tracing/request-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

user: User {
  shape: person
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
}

gateway: API Gateway {
  shape: hexagon
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

order_svc: Order Service {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

payment_svc: Payment Service {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

db: Database {
  shape: cylinder
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

jaeger: Jaeger Collector {
  shape: cloud
  style.fill: "#D35400"
  style.stroke: "#A04000"
  style.font-color: "#FFFFFF"
}

user -> gateway: GET /orders/42
gateway -> order_svc: X-B3-TraceId: abc-123\nX-B3-SpanId: s1
order_svc -> payment_svc: X-B3-TraceId: abc-123\nX-B3-SpanId: s2\nX-B3-ParentSpanId: s1
payment_svc -> db: trace context propagated
db -> payment_svc: result (span s4: 10ms)
payment_svc -> order_svc: 200 OK (span s3: 80ms)
order_svc -> gateway: 200 OK (span s2: 120ms)
gateway -> user: 200 OK (span s1: 50ms)

gateway -> jaeger: "spans (s1: 50ms)" {
  style.stroke-dash: 5
  style.animated: true
}
order_svc -> jaeger: "spans (s2: 120ms)" {
  style.stroke-dash: 5
  style.animated: true
}
payment_svc -> jaeger: "spans (s3, s4)" {
  style.stroke-dash: 5
  style.animated: true
}

scenarios: {
  sampling: {
    gateway: API Gateway\n(1% sampling) {
      style.fill: "#3498DB"
      style.stroke: "#2471A3"
      style.font-color: "#FFFFFF"
    }
    jaeger: Jaeger Collector\n(sampling decision) {
      style.fill: "#D35400"
      style.stroke: "#A04000"
      style.font-color: "#FFFFFF"
    }
  }
}
