# Circuit breaker — cascade prevention
# One idea: without a breaker, blocked threads exhaust the caller too.

vars: { d2-config: { layout-engine: elk } }
direction: right

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

without: "Without breaker" {
  style.fill: "#F1EEE8"
  style.stroke: "#D5D0C8"

  app: "App server\n✖ threads exhausted" {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
  svc: "Payment\n✖ down" {
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
  app -> svc: "waiting…" {
    style.stroke: "#E74C3C"
    style.stroke-dash: 5
  }
}

with: "With breaker" {
  style.fill: "#F1EEE8"
  style.stroke: "#D5D0C8"

  app: "App server\n✓ healthy" {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  cb: "Breaker\nOPEN" {
    shape: hexagon
    style.fill: "#D35400"
    style.stroke: "#A04000"
    style.font-color: "#FFFFFF"
  }
  app -> cb: "503 in 1 ms" {
    style.stroke: "#D35400"
  }
}
