# Ride Sharing — Ride Request Lifecycle
# d2 --sketch --layout elk request-flow.d2 ../../svg/SD03_ride_sharing/request-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

rider: Rider {
  shape: person
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
}

driver: Driver {
  shape: person
  style.fill: "#D35400"
  style.stroke: "#A04000"
}

matching: Matching Service {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

redis: Redis GeoIndex {
  shape: cylinder
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

trip_svc: Trip Service {
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

notif: Notification Service {
  style.fill: "#5D6D7E"
  style.stroke: "#808B96"
  style.font-color: "#FFFFFF"
}

location_svc: Location Service {
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
  style.font-color: "#FFFFFF"
}

payment: Payment Service {
  style.fill: "#E74C3C"
  style.stroke: "#C0392B"
  style.font-color: "#FFFFFF"
}

rider -> matching: request ride
matching -> redis: GEOSEARCH 5km
redis -> matching: 12 drivers
matching -> trip_svc: create trip
trip_svc -> notif: notify driver
notif -> driver: "ride request"
driver -> trip_svc: accept
driver -> location_svc: location 4Hz
location_svc -> redis: GEOADD driver
driver -> trip_svc: completed
trip_svc -> payment: charge + payout {
  style.stroke-dash: 5
  style.animated: true
}
payment -> rider: receipt

scenarios: {
  no_drivers: {
    matching: Matching Service\n(surge zone) {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
    redis -> matching: 0 drivers in 5km {
      style.stroke: "#E74C3C"
      style.stroke-width: 2
    }
  }
}
