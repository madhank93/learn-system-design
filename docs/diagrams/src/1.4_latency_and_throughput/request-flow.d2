# Latency and Throughput — Throughput Scaling Under Load
# d2 --sketch --layout elk request-flow.d2 ../../svg/1.4_latency_and_throughput/request-flow.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

users_low: 1 Concurrent User {
  shape: person
  style.fill: "#27AE60"
  style.stroke: "#1E8449"
}

users_high: 100 Concurrent Users {
  shape: person
  style.fill: "#D35400"
  style.stroke: "#A04000"
}

app_single: App Server\n(10 DB connections) {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

db: Database\n(pool: 10 max) {
  shape: cylinder
  style.fill: "#5D6D7E"
  style.stroke: "#424949"
  style.font-color: "#FFFFFF"
}

scale_out: 4 App Servers (scaled) {
  style.fill: "#F1EEE8"
  style.stroke: "#27AE60"

  a1: Server 1 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  a2: Server 2 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  a3: Server 3 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
  a4: Server 4 {
    style.fill: "#27AE60"
    style.stroke: "#1E8449"
    style.font-color: "#FFFFFF"
  }
}

cache: Cache Layer\n(Redis, 80% hit rate) {
  shape: cylinder
  style.fill: "#D35400"
  style.stroke: "#A04000"
  style.font-color: "#FFFFFF"
}

users_low -> app_single: ~11 RPS, 86ms latency
users_high -> app_single: 100 RPS — queue builds {
  style.stroke: "#E67E22"
  style.stroke-width: 3
}
app_single -> db: 10 concurrent queries max
scale_out.a1 -> cache: check cache first
scale_out.a2 -> cache
scale_out.a3 -> db: cache miss only
scale_out.a4 -> db

scenarios: {
  thundering_herd: {
    cache: Cache Layer\n⚠ EXPIRED {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
    scale_out.a1 -> db: stampede! {
      style.stroke: "#E74C3C"
      style.stroke-width: 3
      style.animated: true
    }
    scale_out.a2 -> db: stampede! {
      style.stroke: "#E74C3C"
      style.stroke-width: 3
      style.animated: true
    }
    scale_out.a3 -> db: stampede! {
      style.stroke: "#E74C3C"
      style.stroke-width: 3
      style.animated: true
    }
    scale_out.a4 -> db: stampede! {
      style.stroke: "#E74C3C"
      style.stroke-width: 3
      style.animated: true
    }
    db: Database\n⚠ OVERWHELMED {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
  }
}
