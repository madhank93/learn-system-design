# Distributed Locking — Redlock Architecture
# d2 --sketch --layout elk overview.d2 ../../svg/5.3_distributed_locking/overview.svg

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

style: {
  fill: "#FBFAF7"
  stroke: "#D5D0C8"
}

service_a: Service A {
  style.fill: "#3498DB"
  style.stroke: "#2471A3"
  style.font-color: "#FFFFFF"
}

service_b: Service B {
  style.fill: "#D35400"
  style.stroke: "#A04000"
  style.font-color: "#FFFFFF"
}

redis_cluster: Redis Cluster (5 nodes) {
  style.fill: "#F1EEE8"
  style.stroke: "#AEB6BF"

  r1: Redis 1 {
    shape: cylinder
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  r2: Redis 2 {
    shape: cylinder
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  r3: Redis 3 {
    shape: cylinder
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  r4: Redis 4 {
    shape: cylinder
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }

  r5: Redis 5 {
    shape: cylinder
    style.fill: "#E74C3C"
    style.stroke: "#C0392B"
    style.font-color: "#FFFFFF"
  }
}

quorum_note: Quorum = 3/5 OK\nTTL = 30s {
  style.fill: "#F1EEE8"
  style.stroke: "#F39C12"
}

service_a -> redis_cluster.r1: SET NX EX 30
service_a -> redis_cluster.r2: SET NX EX 30
service_a -> redis_cluster.r3: SET NX EX 30
service_a -> redis_cluster.r4: SET NX EX 30
service_a -> redis_cluster.r5: SET NX EX 30

service_b -> redis_cluster.r1: SET NX EX 30 {
  style.stroke-dash: 5
  style.opacity: 0.5
}

scenarios: {
  lock_acquired: {
    redis_cluster.r1: Redis 1\n✓ OK {
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
    }
    redis_cluster.r2: Redis 2\n✓ OK {
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
    }
    redis_cluster.r3: Redis 3\n✓ OK {
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
    }
    service_a: Service A\n✓ LOCK ACQUIRED {
      style.fill: "#27AE60"
      style.stroke: "#1E8449"
      style.font-color: "#FFFFFF"
    }
    service_b: Service B\n✗ BLOCKED {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
  }

  lock_expired: {
    service_a: Service A\n⚠ GC PAUSE\n(lock expired!) {
      style.fill: "#E74C3C"
      style.stroke: "#C0392B"
      style.font-color: "#FFFFFF"
    }
  }
}
